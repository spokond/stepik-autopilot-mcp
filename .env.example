# Stepik API and OAuth application credentials.
STEPIK__BASE_URL=https://stepik.org
STEPIK__OAUTH__CLIENT_ID=your-client-id
STEPIK__OAUTH__CLIENT_SECRET=your-client-secret
STEPIK__REQUESTS_PER_SECOND=5.0
STEPIK__REQUEST_BURST=10
STEPIK__MAX_IN_FLIGHT=4
STEPIK__IDS_BATCH_SIZE=30

# Local SQLAlchemy Core storage.
DB__URL=sqlite+aiosqlite:///stepik-autopilot.db
DB__ECHO=false

# Optional directory for exports and other durable artifacts.
DATA_DIR=./data
